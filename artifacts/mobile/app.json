{
  "expo": {
    "name": "pshpsh",
    "slug": "pshpsh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pshpsh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060B10"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#060B10"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "pshpsh",
      "shortName": "pshpsh",
      "themeColor": "#060B10",
      "backgroundColor": "#060B10",
      "meta": {
        "viewport": {
          "content": "width=device-width, initial-scale=1, viewport-fit=cover"
        }
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "pshpsh needs camera access to take photos of your pet.",
          "microphonePermission": false,
          "photosPermission": "pshpsh needs access to your photo library to pick photos of your pet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
